+                            "registryType": "oci",
+                            "identifier": "example/oci-server",
+                            "version": "1.0.0",
+                        }
+                    ],
+                }
+            }
+        ],
+        "metadata": {"count": 1},
+    }
+    bare_page = {
+        "servers": [{"server": {"name": "example/bare-server", "version": "1.0.0"}}],
+        "metadata": {"count": 1},
+    }
+
+    oci_entries = list(
+        paginate(
