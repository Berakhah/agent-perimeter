POSTGRES_PASSWORD=change-me-locally
# `localhost` for bare-metal (CLI/tests run directly on the host, migrating
# against a locally-installed Postgres). docker-compose.yml's `api` service
# overrides this to `db` -- the two containers are not on the host's own
# loopback interface, they reach each other by Docker Compose service name.
POSTGRES_HOST=localhost
AP_CONTACT_URL=https://github.com/USER/agent-perimeter
# Comma-separated browser origins the API's CORS middleware accepts (agent_perimeter/api/app.py).
AP_CORS_ORIGINS=http://localhost:3000
# Browser-side base URL the web UI's fetch calls are built against
# (web/src/lib/api.ts). Under `docker compose up`, web (port 3000) and api
# (port 8000) are separate origins from the browser's point of view, so this
# must be absolute; Next.js inlines NEXT_PUBLIC_* variables at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
